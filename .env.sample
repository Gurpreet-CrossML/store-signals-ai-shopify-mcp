# Sample environment variables for Store Signals AI Shopify MCP

# Port configuration for the application
PORT=3000

# SMTP configuration for sending emails
SMTP_USER="example@gmail.com"
SMTP_PASS="examplepassword"

# Application metadata
MCP_NAME="Store Signals AI Shopify MCP"
MCP_VERSION="your-mcp-version-here"

# Backend API configuration
BACKEND_API_URL="http://localhost:8080"

# OpenAI API configuration
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="your-openai-model-here"

# Cache configuration for the application
CACHE_TTL_MS="your-ttl-ms-here"
CACHE_SIMILARITY_THRESHOLD="your-similarity-threshold-here"
CACHE_MAX_ENTRIES="your-max-entries-here"